rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "is3.5inchesisenough@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'phoneNumber', 'role']) &&
             data.uid is string &&
             data.phoneNumber is string &&
             data.phoneNumber.matches("^\\+63\\d{10}$") &&
             data.role in ['admin', 'user'];
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['name', 'content', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 1000 &&
             data.createdBy == request.auth.uid;
    }

    function isValidMessageLog(data) {
      return data.keys().hasAll(['senderUid', 'recipient', 'message', 'status', 'type']) &&
             data.senderUid == request.auth.uid &&
             data.recipient is string &&
             data.message is string &&
             data.status in ['sent', 'failed'] &&
             data.type in ['single', 'bulk'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin()) && request.resource.data.role == resource.data.role;
    }

    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTemplate(request.resource.data);
      allow update: if isAuthenticated() && isValidTemplate(request.resource.data) && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    match /messageLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidMessageLog(request.resource.data);
    }
  }
}
